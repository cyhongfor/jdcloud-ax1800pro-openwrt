# ============================================================================
# 插件选择清单 —— 按你的需求定制
#   需求：好用 ｜ 带 VPN 且走 IPv6 ｜ 安全 + 可视化程度高 ｜ 稳定升级 ｜ 空间合理
#
# 规则： =y 编进固件 | =m 编成包不进固件 | 注释掉 = 不编译
#
# ★ 格式约定（重要）：注释只能**单独占一行**，绝不要写在设置项后面当行内注释。
#   依据：本机型真实构建成功的配置里，行内注释为 0 行、整行注释 7076 行 ——
#   Kconfig 的规范写法就是整行注释。工作流里有一道"配置卫生检查"会把违规拦下来。
#
# 包名核实：全部对照 immortalwrt/luci、immortalwrt/packages 的 openwrt-25.12
#          分支目录，并与真实构建配置交叉验证。
#          万一还有错，工作流的 check-packages 步骤会当场指出，不会静默漏包。
#
# 设计说明与取舍理由见 docs/06-固件方案(按需求).md
# ============================================================================

# ---------------------------------------------------------------- ① 好用：界面与工具
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

# 以上依次是：
#   中文界面 / argon 主题 / 主题设置 / 网页终端 / 终端中文包 / 网页文件管理 /
#   磁盘分区图形化 / apk 图形界面（以后装插件点两下） / 自定义命令按钮 /
#   定时重启 / 挂载支持 / ext4 支持 / f2fs 支持
#
# 可选（需要就取消下面两行的注释）：
#   luci-app-wifischedule  无线定时开关
# CONFIG_PACKAGE_luci-app-wifischedule=y
#
# 说明：cpufreq / autocore / automount / uboot-envtools 由本机型 target 默认包
#       自动带上，这里不用写。

# ---------------------------------------------------------------- ② IPv6 与网络质量
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-wol=y

# 以上依次是：
#   IPv6 配置界面 / IPv6 RA+DHCPv6 服务端（LAN 分发 IPv6） /
#   PPPoE 协议界面（你现网就是 PPPoE） / PPPoE 拨号模块 /
#   动态域名（IPv6 要更新 AAAA 记录） / DDNS 脚本 / Cloudflare 支持 /
#   SQM 抗缓冲膨胀界面 / SQM 脚本 / 网络唤醒（你在用）

# ---------------------------------------------------------------- ③ VPN：IPv6 优先
# 主方案：WireGuard。内核态、开销小、原生支持 IPv6 端点，
#         在没有公网 IPv4（CGNAT）的宽带上依然能从外面连回家。
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# 备用：OpenVPN。你备份里有完整证书，可以直接沿用，同样支持 IPv6。
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_openvpn-openssl=y

# 保底：ZeroTier。完全不需要公网端口和 DDNS，客户端没有 IPv6 时也能用。
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_zerotier=y

# 可选：Tailscale。穿透能力强，但上游没有 LuCI 界面，只能命令行配置。
# CONFIG_PACKAGE_tailscale=y

# 不装 IPsec：IPQ60xx 没有 IPSec 的 NSS 卸载，只能纯 CPU 跑且吃内存。
# 以后真要加：apk add strongswan，不需要重编固件。
# CONFIG_PACKAGE_strongswan=y

# ---------------------------------------------------------------- ④ 安全 + 可视化
# banip：按国家/黑名单主动封禁来源 IP，带封禁统计与来源可视化（安全可视化主力）
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_banip=y

# https-dns-proxy：DoH/DoT 加密 DNS，防运营商劫持与投毒
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_https-dns-proxy=y

# adblock：广告/恶意域名拦截，带拦截统计
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_adblock=y

# statistics：collectd + RRDtool 历史曲线（会自动带上 collectd 及所需模块）
# vnstat2：日/月流量图表
# nlbwmon：每台内网设备的流量排行
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# 可选：netdata 的实时仪表盘是可视化天花板，但常驻内存约 40–80MB。
# 你的机器只有 406MB 内存，默认不开；想要就 apk add 装，不满意再卸。
# CONFIG_PACKAGE_luci-app-netdata=y
# CONFIG_PACKAGE_netdata=y

# 可选：IP/MAC 绑定（防 ARP 欺骗，代价是每台设备都要手工登记）
# CONFIG_PACKAGE_luci-app-arpbind=y

# ---------------------------------------------------------------- ⑤ 代理（三选一，别同时上）
# 同时装会因同名依赖包冲突。你在用 openclash，第三方源由 diy-1 按需添加。
CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-ssr-plus=y

# ---------------------------------------------------------------- 明确不装（含理由）
#
# UPnP：你现网在用，但它等于让内网设备自己开防火墙端口，是实打实的安全敞口。
#       你要"安全"，所以默认不装；确实需要时再 apk add。
# CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_miniupnpd-nftables=y
#
# qbittorrent：内存紧张时最该砍的一个，建议最后再考虑。
# CONFIG_PACKAGE_luci-app-qbittorrent=y
# CONFIG_PACKAGE_qbittorrent-enhanced-edition=y
#
# turboacc：SFE/flow-offload 与 NSS 硬件卸载功能重复且会互相打架 → 绝对不要开。
# CONFIG_PACKAGE_luci-app-turboacc=y
#
# 以下在 LibWrt 上不存在（iStoreOS 专属 / QCA 闭源驱动专属）：
#   istore、linkease、ddnsto、homebox、quickstart、mia、qcacfg80211、ssid-steering
# luci feed 里也没有的：luci-app-mdadm、luci-app-rstp、luci-app-wolplus、luci-app-tailscale
